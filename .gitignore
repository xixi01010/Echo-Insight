# Local environment files and credentials (never commit)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/*secret*
**/*token*
**/*password*
**/*credential*
!02_工程代码/backend/src/current-user/feishu-user-credential-provider.ts
!02_工程代码/tests/user-credential-lifecycle.test.ts
**/*api[_-]key*
**/*private[_-]key*
**/*.pem
**/*.p12
**/*.pfx
**/*.key

# Dependencies and generated output
**/node_modules/
**/.venv/
**/dist/
**/coverage/
**/.cache/
**/.vite/
**/.runtime/
*.log

# Private local resources and process material
/03_资源文件/
/04_过程记录/

# Public-repository boundary (tracked private files still require index/history cleanup)
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README.en.md
!/LICENSE
!/LICENSE-DOCS.md
!/THIRD_PARTY_NOTICES.md
!/TRADEMARKS.md
!/setup-local.cmd
!/setup-local.ps1
!/setup-local.sh
!/00_项目控制台/
!/01_项目文档/
!/02_工程代码/

# Only the public navigation, risk rules, and AI output protocol are publishable docs
/01_项目文档/*

# Production mode enables the real Feishu OAuth and runtime safety boundaries.
NODE_ENV=production

# Frontend build-time setting. Leave blank for local Vite /api proxy.
VITE_API_BASE_URL=

# Backend CORS setting. Set the exact deployed Frontend origin, without a path.
FRONTEND_ORIGIN=

# Backend durable runtime directory. Required in production unless Railway provides
# RAILWAY_VOLUME_MOUNT_PATH through an attached Volume.
ECHO_INSIGHT_RUNTIME_DIR=

# Required when ECHO_INSIGHT_AI_ACCESS_MODE=visitor. Generate 32 random bytes,
# encode them as canonical Base64, and keep the value only in a deployment
# secret or server-side .env. Do not reuse FEISHU_APP_SECRET.
ECHO_INSIGHT_USER_AI_CREDENTIAL_MASTER_KEY=

# Feishu production login requires the server-side App credentials and the exact
# redirect URI registered for this deployment. Never expose them to the Frontend.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_IDENTITY_REDIRECT_URI=

# Legacy single-Base and development-seed paths may require this Base token.
# It is a data-source credential, not a Feishu login credential.
FEISHU_BASE_TOKEN=

# V2 development-only project runtime. These values are ignored in production.
ECHO_INSIGHT_DEV_USER_ID=
ECHO_INSIGHT_DEV_DATA_SOURCE_REF=
ECHO_INSIGHT_DEV_SEED_PROJECT=false
ECHO_INSIGHT_DEV_PROJECT_NAME=

# setup-local writes the Feishu app, deployment runtime, and selected AI provider
# to a new server-side .env. It never reads or overwrites an existing .env.
# AI calls are billed by the selected model provider, not by Echo Insight.
# Provider timeout values must be integers from 1000 through 35000 milliseconds.
# Self-hosted setup explicitly uses the server-managed Provider below. When this
# setting is absent, the backend fails closed to visitor BYOK and never falls
# back to a deployment-owner key for signed-in visitors.
ECHO_INSIGHT_AI_ACCESS_MODE=server
AI_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_CHAT_COMPLETIONS_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_TIMEOUT_MS=30000

# Standard Qianwen AI Platform pay-as-you-go preset. Token Plan users should choose
# OpenAI-compatible and provide the dedicated key and full endpoint from its docs.
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.8-flash
DASHSCOPE_CHAT_COMPLETIONS_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_TIMEOUT_MS=30000

# A complete endpoint ending in /chat/completions and a model are required.
# Remote endpoints must use HTTPS; local HTTP is limited to loopback addresses.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_CHAT_COMPLETIONS_URL=
OPENAI_COMPATIBLE_TIMEOUT_MS=30000
OPENAI_COMPATIBLE_JSON_MODE=json_object
OPENAI_COMPATIBLE_TOKEN_LIMIT_FIELD=max_tokens

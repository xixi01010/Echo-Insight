{
  "name": "echo-insight-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "node scripts/setup-local.mjs --run-tests",
    "setup:local": "node scripts/setup-local.mjs",
    "start:backend": "tsx backend/src/index.ts",
    "review:backend": "tsx scripts/v3-review-server.ts",
    "demo:backend": "tsx scripts/v3-demo-server.ts",
    "review:real-tenant": "tsx scripts/v3-real-tenant-server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build:frontend": "tsc -p frontend/tsconfig.json --noEmit && vite build --config frontend/vite.config.ts",
    "preview:frontend": "vite preview --config frontend/vite.config.ts",
    "ai-model-test": "tsx scripts/ai-model-test.ts",
    "ai-runtime-smoke:deepseek": "tsx scripts/deepseek-runtime-smoke.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.73.0",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "weui": "^2.6.26"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "feishu-connector/src/**/*.ts",
    "backend/src/**/*.ts",
    "functions/**/*.ts",
    "tests/**/*.ts",
    "ai-service/src/**/*.ts",
    "scripts/**/*.ts"
  ]
}



